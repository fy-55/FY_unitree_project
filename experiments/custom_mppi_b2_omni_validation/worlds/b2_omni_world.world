<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>

    <scene>
      <shadows>false</shadows>
    </scene>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>100</iters>
          <sor>1.3</sor>
        </solver>
      </ode>
    </physics>

    <!-- Reuse the official TurtleBot3 obstacle world and matching Nav2 map. -->
    <model name="turtlebot3_world">
      <static>true</static>
      <include>
        <uri>model://turtlebot3_world</uri>
      </include>
    </model>

    <!--
      This is deliberately a 2D command-to-odometry plant, not a leg model.
      The planar plugin accepts vx, vy and wz, which lets us test the current
      B2-oriented controller without the differential-drive restriction.
    -->
    <model name="b2_omni_base">
      <pose>-2.0 -0.5 0.21 0 0 0</pose>
      <link name="base_link">
        <inertial>
          <mass>30.0</mass>
          <inertia>
            <ixx>1.3</ixx>
            <iyy>2.8</iyy>
            <izz>3.1</izz>
          </inertia>
        </inertial>

        <collision name="body_collision">
          <geometry>
            <box>
              <size>1.0 0.6 0.4</size>
            </box>
          </geometry>
        </collision>

        <visual name="body_visual">
          <geometry>
            <box>
              <size>1.0 0.6 0.4</size>
            </box>
          </geometry>
          <material>
            <ambient>0.10 0.25 0.55 1</ambient>
            <diffuse>0.12 0.35 0.80 1</diffuse>
          </material>
        </visual>

        <sensor name="planar_lidar" type="ray">
          <pose>0 0 0.30 0 0 0</pose>
          <always_on>true</always_on>
          <visualize>false</visualize>
          <update_rate>15</update_rate>
          <ray>
            <scan>
              <horizontal>
                <samples>360</samples>
                <resolution>1.0</resolution>
                <min_angle>-3.14159265</min_angle>
                <max_angle>3.14159265</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.10</min>
              <max>6.0</max>
              <resolution>0.01</resolution>
            </range>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.005</stddev>
            </noise>
          </ray>
          <plugin name="b2_omni_laserscan"
                  filename="libgazebo_ros_ray_sensor.so">
            <ros>
              <remapping>~/out:=scan</remapping>
            </ros>
            <output_type>sensor_msgs/LaserScan</output_type>
            <frame_name>base_scan</frame_name>
          </plugin>
        </sensor>
      </link>

      <plugin name="b2_omni_planar_move"
              filename="libgazebo_ros_planar_move.so">
        <ros>
          <remapping>cmd_vel:=cmd_vel</remapping>
          <remapping>odom:=odom</remapping>
        </ros>
        <update_rate>100</update_rate>
        <publish_rate>50</publish_rate>
        <publish_odom>true</publish_odom>
        <publish_odom_tf>true</publish_odom_tf>
        <odometry_frame>odom</odometry_frame>
        <robot_base_frame>base_link</robot_base_frame>
        <covariance_x>0.0001</covariance_x>
        <covariance_y>0.0001</covariance_y>
        <covariance_yaw>0.001</covariance_yaw>
      </plugin>
    </model>
  </world>
</sdf>
