<?xml version="1.0"?>
<sdf version="1.6">
  <world name="g1_nav_test">

    <!-- 地球重力 -->
    <gravity>0 0 -9.81</gravity>

    <!-- 仿真物理参数 -->
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- 地面 -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- 光源 -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- 前方墙壁 -->
    <model name="front_wall">
      <static>true</static>
      <pose>3.0 0.0 1.0 0 0 0</pose>

      <link name="wall_link">
        <collision name="wall_collision">
          <geometry>
            <box>
              <size>0.20 6.0 2.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="wall_visual">
          <geometry>
            <box>
              <size>0.20 6.0 2.0</size>
            </box>
          </geometry>

          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 第一个障碍物 -->
    <model name="box_obstacle">
      <static>true</static>
      <pose>1.2 1.0 0.40 0 0 0</pose>

      <link name="box_link">
        <collision name="box_collision">
          <geometry>
            <box>
              <size>0.60 0.60 0.80</size>
            </box>
          </geometry>
        </collision>

        <visual name="box_visual">
          <geometry>
            <box>
              <size>0.60 0.60 0.80</size>
            </box>
          </geometry>

          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
            <diffuse>0.8 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 第二个低矮障碍物 -->
    <model name="low_obstacle">
      <static>true</static>
      <pose>-1.0 -1.2 0.15 0 0 0</pose>

      <link name="low_obstacle_link">
        <collision name="low_collision">
          <geometry>
            <box>
              <size>1.0 0.40 0.30</size>
            </box>
          </geometry>
        </collision>

        <visual name="low_visual">
          <geometry>
            <box>
              <size>1.0 0.40 0.30</size>
            </box>
          </geometry>

          <material>
            <ambient>0.2 0.3 0.8 1</ambient>
            <diffuse>0.2 0.3 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
      <!-- G1平面导航代理模型 -->
    <include>
      <uri>model://g1_nav_proxy</uri>
      <name>g1_nav_proxy</name>
      <pose>0 0 0 0 0 0</pose>
    </include>
  </world>
</sdf>