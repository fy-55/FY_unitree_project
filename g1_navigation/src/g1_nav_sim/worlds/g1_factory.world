<?xml version="1.0"?>
<sdf version="1.6">
  <world name="g1_factory">
    <gravity>0 0 -9.81</gravity>

    <physics name="default_physics" type="ode">
      <!-- 500 Hz is ample for the planar proxy and leaves CPU for 3-D rays. -->
      <max_step_size>0.002</max_step_size>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://g1_factory_environment</uri>
      <name>g1_factory_environment</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- G1 starts in the open central inspection corridor. -->
    <include>
      <uri>model://g1_nav_proxy</uri>
      <name>g1_nav_proxy</name>
      <pose>0 0 0 0 0 0</pose>
    </include>
  </world>
</sdf>
