      <!-- END GENERATED G1 SHELL VISUALS -->

      <!--
        Simplified 3-D Mid-360 substitute.

        The sensor is mounted at the official zero-pose livox_frame location.
        It publishes a PointCloud2 on the same raw topic as the physical G1;
        g1_nav_sensors then reuses the real pointcloud-to-LaserScan chain.

        A CPU ray sensor is used instead of a GPU ray sensor so that headless
        tests do not depend on an OpenGL rendering context.
      -->
      <sensor name="simulated_mid360" type="ray">
        <pose>-0.00368 0.00003 1.254452897 3.141592653589793 0.04014257279586953 0</pose>

        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>10.0</update_rate>

        <ray>
          <scan>
            <horizontal>
              <!-- 1 degree horizontal resolution is sufficient for 5 cm SLAM. -->
              <samples>360</samples>
              <resolution>1.0</resolution>
              <min_angle>-3.141592653589793</min_angle>
              <max_angle>3.141592653589793</max_angle>
            </horizontal>

            <!--
              The vertical field of view lets the head-mounted sensor see
              low obstacles, unlike a single horizontal ray plane.
            -->
            <vertical>
              <!-- Twelve layers retain low-obstacle coverage at lower CPU cost. -->
              <samples>12</samples>
              <resolution>1.0</resolution>
              <min_angle>-0.6981317007977318</min_angle>
              <max_angle>0.6981317007977318</max_angle>
            </vertical>
          </scan>

          <range>
            <min>0.30</min>
            <max>15.0</max>
            <resolution>0.01</resolution>
          </range>

          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.005</stddev>
          </noise>
        </ray>

        <plugin
          name="simulated_mid360_pointcloud"
          filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <namespace>/</namespace>
            <remapping>
              ~/out:=/utlidar/cloud_livox_mid360
            </remapping>
          </ros>

          <output_type>sensor_msgs/PointCloud2</output_type>
          <frame_name>livox_frame</frame_name>
        </plugin>
      </sensor>

    </link>

    <!--
      Gazebo平面运动插件。

      输入：
        /cmd_vel_safe

      输出：
        /odom
        odom -> base_footprint
    -->
    <plugin
      name="g1_planar_move"
      filename="libgazebo_ros_planar_move.so">

      <ros>
        <namespace>/</namespace>

        <remapping>
          cmd_vel:=/cmd_vel_safe
        </remapping>

        <remapping>
          odom:=/odom
        </remapping>
      </ros>

      <!-- Gazebo内部更新运动的频率 -->
      <update_rate>100.0</update_rate>

      <!-- ROS 2发布里程计的频率 -->
      <publish_rate>20.0</publish_rate>

      <publish_odom>true</publish_odom>

      <publish_odom_tf>true</publish_odom_tf>

      <odometry_frame>odom</odometry_frame>

      <robot_base_frame>base_footprint</robot_base_frame>

      <covariance_x>0.0001</covariance_x>
      <covariance_y>0.0001</covariance_y>
      <covariance_yaw>0.001</covariance_yaw>

    </plugin>

  </model>

</sdf>
