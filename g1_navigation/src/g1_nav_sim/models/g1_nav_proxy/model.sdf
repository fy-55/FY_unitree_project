<?xml version="1.0"?>
<sdf version="1.6">

  <model name="g1_nav_proxy">

    <!-- 该模型需要移动，所以不能是static -->
    <static>false</static>

    <!-- 代理模型只有一个link，不需要自身碰撞 -->
    <self_collide>false</self_collide>

    <!-- 防止Gazebo长时间静止后休眠模型 -->
    <allow_auto_disable>false</allow_auto_disable>

    <!--
      base_footprint位于地面。
      后续Gazebo发布：
      odom -> base_footprint
    -->
    <link name="base_footprint">

      <!--
        This is a navigation proxy, not a walking-dynamics simulation.
        The planar motion plugin directly commands x/y/yaw velocity; leaving
        gravity enabled lets ground friction create a fake pitch transient
        whenever cmd_vel changes.  Keep the proxy gravity-free so the lidar
        frame stays level while mapping.
      -->
      <gravity>false</gravity>

      <!--
        近似质量只用于Gazebo物理计算。
        第一版不试图精确模拟G1动力学。
      -->
      <inertial>
        <pose>0 0 0.25 0 0 0</pose>

        <mass>35.0</mass>

        <inertia>
          <ixx>1.78</ixx>
          <iyy>1.78</iyy>
          <izz>2.10</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>

      <!--
        真机实测约x=0.35米、y=0.65至0.70米。
        代理碰撞体采用Nav2未加padding的保守外廓：x=0.40米、y=0.70米。
        碰撞体较低，使代理模型不容易倾倒。
      -->
      <collision name="navigation_collision">
        <pose>0 0 0.25 0 0 0</pose>

        <geometry>
          <box>
            <size>0.40 0.70 0.50</size>
          </box>
        </geometry>

        <!--
          The planar plugin supplies motion directly, so tire/foot friction is
          neither needed nor physically meaningful here.  Zero tangential
          friction prevents start/stop commands from tipping the rigid shell.
        -->
        <surface>
          <friction>
            <ode>
              <mu>0.0</mu>
              <mu2>0.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <!-- BEGIN GENERATED G1 SHELL VISUALS -->
      <!--
        Generated from the official 29-DoF G1 URDF at zero joint angles.
        These meshes are visual-only; navigation collision and dynamics
        remain the simple planar proxy defined above.
        Pelvis height above base_footprint: 0.794272897 m.
        Shell bounds after alignment (m):
        x=[-0.0725741163, 0.416738941], y=[-0.181570267, 0.181580267], z=[0.002, 1.32484549].
      -->
      <visual name="shell_pelvis_0_0">
        <pose>0 0 0.794272897 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file://g1_nav_description/meshes/pelvis.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
        <cast_shadows>true</cast_shadows>
      </visual>
      <visual name="shell_pelvis_contour_link_0_0">
        <pose>0 0 0.794272897 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file://g1_nav_description/meshes/pelvis_contour_link.STL</uri>
