<?xml version="1.0" encoding="UTF-8"?>
<CycloneDDS>
  <Domain>
    <Discovery>
      <!--
        CycloneDDS defaults to participant indexes 0..9.  The complete G1
        simulation, localization, Nav2, Collision Monitor and RViz exceed
        that limit, so reserve a larger local range for simulation.
      -->
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>50</MaxAutoParticipantIndex>
    </Discovery>
  </Domain>
</CycloneDDS>
